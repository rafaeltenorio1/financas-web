# Copie para .env e preencha. Nunca commite o .env.

# Banco (usado pelo container do Postgres e pela API)
POSTGRES_USER=financas
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=financas

# pgAdmin (profile "tools")
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=troque-esta-senha

# Sessão e segurança
# false só em desenvolvimento (http); em produção com https, true.
COOKIE_SECURE=false
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=troque-por-um-valor-aleatorio
# Chave que cifra os segredos do 2FA no banco. Não troque depois de usar: os segredos ficariam ilegíveis.
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_CHAVE=troque-por-uma-chave-fernet
# Lista JSON com as origens do front-end autorizadas (CORS e verificação de Origin).
CORS_ORIGINS=["http://localhost:5500"]
