# Copie para .env e preencha. Nunca commite o .env.

# Banco (usado pelo container do Postgres e pela API)
POSTGRES_USER=financas
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=financas

# pgAdmin (profile "tools")
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=troque-esta-senha

# Ambiente: desenvolvimento (liga /docs e aceita http) ou producao (padrão se omitido).
# Em producao a API recusa subir com configuração insegura.
AMBIENTE=desenvolvimento
# Lista JSON com os IPs ou redes dos proxies reversos cujo X-Forwarded-For é aceito.
# Vazia em desenvolvimento. Nunca use "*": qualquer um falsificaria o IP e escaparia do bloqueio.
PROXIES_CONFIAVEIS=[]

# Sessão e segurança
# false só em desenvolvimento (http); em produção com https, true.
COOKIE_SECURE=false
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=troque-por-um-valor-aleatorio
# Chave que cifra os segredos do 2FA no banco. Não troque depois de usar: os segredos ficariam ilegíveis.
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_CHAVE=troque-por-uma-chave-fernet
# Lista JSON com as origens do front-end autorizadas (CORS e verificação de Origin).
CORS_ORIGINS=["http://localhost:5500"]

# E-mail (SMTP)
# Em desenvolvimento, o Mailpit do docker compose captura tudo: caixa em http://localhost:8025.
# Em produção, use o SMTP do provedor (ex.: smtp.gmail.com, porta 587, starttls, senha de app).
SMTP_HOST=mailpit
SMTP_PORTA=1025
# starttls (porta 587), ssl (porta 465) ou nenhuma (só para o Mailpit local).
SMTP_SEGURANCA=nenhuma
SMTP_USUARIO=
SMTP_SENHA=
EMAIL_REMETENTE=Balancia <nao-responda@balancia.local>

# Endereço do front-end, usado nos links enviados por e-mail.
FRONT_URL=http://localhost:5500
